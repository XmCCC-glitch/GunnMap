{
  "manifest_version": 3,
  "name": "GunnWatt Campus Connector",
  "version": "0.1.0",
  "description": "Import your Infinite Campus schedule once, on your own device. No sync server.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://pausdca.infinitecampus.org/*",
    "https://xmccc-glitch.github.io/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GunnWatt Campus Connector",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "content_scripts": [
    {
      "matches": ["https://pausdca.infinitecampus.org/*"],
      "js": ["campus-content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://xmccc-glitch.github.io/GunnMap/*", "http://127.0.0.1:8000/*", "http://localhost:8000/*"],
      "js": ["site-content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "incognito": "not_allowed",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
