{
  "name": "gunnmap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:web && node --import tsx src/web_app.ts",
    "build:web": "tsc --noEmit -p tsconfig.web.json && tsc -p tsconfig.worker.json && vite build && node --import tsx src/build_map_assets.ts && node --import tsx src/build_offline.ts",
    "build:pages": "npm run data:validate && VITE_PAGES=true npm run build:web && node --import tsx src/build_pages.ts",
    "prebuild": "npm run data:validate",
    "build": "tsc && npm run build:web",
    "start": "node dist/src/web_app.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.worker.json",
    "test": "npm run build:web && tsx --tsconfig tsconfig.web.json --test src/tests/test_*.ts",
    "highlight": "node --import tsx src/map_cli.ts",
    "map:index": "node --import tsx src/map_cli.ts --index",
    "map:rebuild": "node --import tsx src/build_n_map.ts",
    "map:preview": "node --import tsx src/schedule_preview.ts",
    "map:validate": "node --import tsx src/n_floor_validation.ts",
    "data:validate": "node --import tsx src/validate_map_data.ts"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@panzoom/panzoom": "^4.6.2",
    "@tarekraafat/autocomplete.js": "^10.2.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
