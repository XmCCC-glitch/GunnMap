{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gunnmap-visits",
  "main": "worker.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SITE_ORIGIN": "https://xmccc-glitch.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gunnmap-visits",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "VISIT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": false }
}
